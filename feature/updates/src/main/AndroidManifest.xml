<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        The only network use in Hush: an optional check of github.com/nzrbits/hush releases,
        off by default. REQUEST_INSTALL_PACKAGES lets Hush hand the downloaded APK to the
        system installer; the user grants "install unknown apps" once.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <receiver
            android:name=".UpdateReceiver"
            android:exported="false" />
    </application>
</manifest>
