<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!--
            Notification listener. Only active when the user grants Notification Access and
            turns the filter on. Matching notifications are stored locally and removed from the
            shade; everything else passes through untouched.
        -->
        <service
            android:name=".service.HushNotificationListener"
            android:exported="false"
            android:label="Hush: Benachrichtigungsfilter"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
